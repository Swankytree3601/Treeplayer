<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TreePlayer" parent="Base.Theme.TreePlayer">
        <!-- Sobrescribe colores para modo oscuro -->
        <item name="android:windowBackground">@color/fondo_principal</item>
        <item name="colorPrimary">@color/color_primario</item>
        <item name="colorPrimaryVariant">@color/color_primario_variante</item>
        <item name="colorOnPrimary">@color/fondo_principal</item>

        <item name="colorSecondary">@color/color_secundario</item>
        <item name="colorOnSecondary">@color/fondo_principal</item>

        <item name="android:colorBackground">@color/superficie_tarjeta</item>
        <item name="android:textColorPrimary">@color/texto_primario_dark</item>
        <item name="android:textColorSecondary">@color/texto_secundario_dark</item>

        <!-- Barra de estado para modo oscuro -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/verde_profundo</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/fondo_principal</item>
    </style>
</resources>