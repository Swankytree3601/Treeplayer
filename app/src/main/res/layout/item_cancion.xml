<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/superficie_tarjeta">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <!-- Número de canción (índice) -->
        <TextView
            android:id="@+id/tvNumero"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="01"
            android:textSize="14sp"
            android:textColor="@color/texto_secundario_dark"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Portada del álbum (placeholder) -->
        <ImageView
            android:id="@+id/ivPortada"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_default_album_final"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/tvNumero"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize8" />

        <!-- Título de la canción -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/main_no_song_selected"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/texto_primario_dark"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@+id/ivPortada"
            app:layout_constraintEnd_toStartOf="@+id/tvDuracion"
            app:layout_constraintTop_toTopOf="@+id/ivPortada"
            app:layout_constraintBottom_toTopOf="@+id/tvArtista" />

        <!-- Artista -->
        <TextView
            android:id="@+id/tvArtista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="14sp"
            android:textColor="@color/texto_secundario_dark"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@+id/ivPortada"
            app:layout_constraintEnd_toStartOf="@+id/tvDuracion"
            app:layout_constraintTop_toBottomOf="@+id/tvTitulo"
            app:layout_constraintBottom_toBottomOf="@+id/ivPortada" />

        <!-- Duración -->
        <TextView
            android:id="@+id/tvDuracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:45"
            android:textSize="14sp"
            android:textColor="@color/texto_secundario_dark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="12dp" />

        <!-- Botón de menú (3 puntos) -->
        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_more_vert"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"
            app:tint="@color/texto_secundario_dark" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>