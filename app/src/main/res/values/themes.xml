<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - AHORA CON COLORES CLAROS -->
    <style name="Base.Theme.TreePlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:windowBackground">@color/fondo_principal_light</item>
        <item name="colorPrimary">@color/verde_brillante</item>
        <item name="colorPrimaryVariant">@color/verde_profundo</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/marrón_claro</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/superficie_tarjeta_light</item>
        <item name="android:textColorPrimary">@color/texto_primario_light</item>
        <item name="android:textColorSecondary">@color/texto_secundario_light</item>

        <!-- Barra de estado y navegación para light theme -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/verde_profundo</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/fondo_principal_light</item>
    </style>

    <style name="Theme.TreePlayer" parent="Base.Theme.TreePlayer" />
</resources>